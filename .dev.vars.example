# Copy this to .dev.vars for local development (gitignored)
# For production, set these via: wrangler secret put <KEY>

# From Supabase → Settings → API
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Your MoneyMani account email — all queries are scoped to this user
USER_EMAIL="your@email.com"

# Optional: protect the MCP endpoint with a bearer token
# MCP_AUTH_KEY="your-secret-key"
