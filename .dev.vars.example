# Copy this to .dev.vars for local development (gitignored)
# For production, set these via: wrangler secret put <KEY>

# Your deployed MoneyMani Vercel app URL (no trailing slash)
MONEYMANI_API_URL="https://your-app.vercel.app"

# Your personal API key — generate it from MoneyMani Settings → MCP Integration
# It looks like: mm_xxxxxxxxxxxxxxxx...
MONEYMANI_API_KEY="mm_your-key-from-settings"
